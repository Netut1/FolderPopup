<Window x:Class="FolderPopup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Popup" Width="480" Height="400">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Добавить папку…" Click="Add_Click" Padding="12,6"/>
            <Button Content="Убрать" Click="Remove_Click" Padding="12,6" Margin="8,0,0,0"/>
            <Button Content="Создать / обновить ярлыки" Click="Apply_Click" Padding="12,6" Margin="8,0,0,0"/>
        </StackPanel>
        <ListBox x:Name="FolderList"/>
    </DockPanel>
</Window>
